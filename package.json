{
  "name": "dsh-peak-reminder",
  "version": "0.3.1",
  "description": "DSH plugin: reminds you when DeepSeek is on peak-hour pricing, tracks this week's peak spend, and can pause running tasks during peak hours and resume them in the valley. English fork.",
  "icon": "icon.svg",
  "license": "MIT",
  "author": "54nanmiao (original), Holorigg (English fork)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Holorigg/dsh-peak-reminder.git"
  },
  "homepage": "https://github.com/Holorigg/dsh-peak-reminder#readme",
  "bugs": {
    "url": "https://github.com/Holorigg/dsh-peak-reminder/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/run.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "peak",
    "peak-hours",
    "reminder",
    "billing",
    "pause",
    "resume",
    "scheduler"
  ],
  "engines": {
    "node": ">=22.13.0"
  }
}
